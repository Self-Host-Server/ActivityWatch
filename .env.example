# Copy this file to .env and fill in real values before running `docker compose up`.

# Django's secret key, used to sign sessions/cookies. Generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=

# Set to "true" once the gateway is served over HTTPS (e.g. behind a reverse proxy
# terminating TLS). Keep "false" for local/plain-HTTP testing.
SESSION_HTTPS_ONLY=false

# Comma-separated hostnames the gateway will accept requests for, e.g. aw.example.com.
# "*" is fine for local/LAN use.
ALLOWED_HOSTS=*

# Optional: enables a "Login with Authentik" option alongside local username/password
# login. Create an OAuth2/OIDC Provider + Application for this instance in your
# existing Authentik, then fill these in (leave blank to disable Authentik login).
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
